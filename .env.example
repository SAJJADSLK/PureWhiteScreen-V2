# ============================================================================
# Screen Lab Environment Variables
# ============================================================================
# Copy this file to .env.local for local development or set these variables
# in your Vercel project settings for production deployment.
# ============================================================================

# ============================================================================
# Database Configuration
# ============================================================================
# MySQL database connection string
# Format: mysql://username:password@host:port/database
# Example: mysql://root:password@localhost:3306/screenlab
DATABASE_URL=mysql://user:password@host:port/database

# ============================================================================
# Authentication & OAuth
# ============================================================================
# Manus OAuth Application ID
VITE_APP_ID=your_app_id

# JWT Secret for session signing (use a strong, random string)
JWT_SECRET=your_jwt_secret_change_this_in_production

# OAuth Server URL (Manus OAuth provider)
OAUTH_SERVER_URL=https://oauth.example.com

# Owner's Open ID (for admin privileges)
OWNER_OPEN_ID=your_owner_open_id

# OAuth Portal URL for login redirects
VITE_OAUTH_PORTAL_URL=https://oauth.example.com

# ============================================================================
# Storage & File Upload Configuration
# ============================================================================
# Forge API URL (for S3 presigned URLs and file uploads)
BUILT_IN_FORGE_API_URL=https://forge.example.com

# Forge API Key (for authentication with Forge service)
BUILT_IN_FORGE_API_KEY=your_forge_api_key

# ============================================================================
# Analytics Configuration (Optional)
# ============================================================================
# Analytics endpoint (e.g., Umami, Plausible, etc.)
# Leave empty to disable analytics
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com

# Analytics website ID
VITE_ANALYTICS_WEBSITE_ID=your_website_id

# ============================================================================
# Node Environment
# ============================================================================
# Set to 'production' for Vercel deployments
# Set to 'development' for local development
NODE_ENV=production

# ============================================================================
# Optional: Vercel-Specific Configuration
# ============================================================================
# Port for local development (Vercel ignores this)
PORT=3000

# ============================================================================
# Notes for Vercel Deployment
# ============================================================================
# 1. Create these environment variables in Vercel Project Settings
# 2. Set them for Production, Preview, and Development environments
# 3. Ensure DATABASE_URL points to a database accessible from Vercel
# 4. Use strong, unique values for JWT_SECRET and API keys
# 5. Test locally with 'vercel dev' before deploying
